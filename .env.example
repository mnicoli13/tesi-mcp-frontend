# API Configuration
VITE_API_BASE_URL=http://localhost:3000

# OpenRouter Configuration
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Vercel AI SDK Configuration (optional, if different from OpenRouter)
VITE_AI_PROVIDER=openrouter

# Environment
VITE_ENV=development

# Optional: Sentry or other monitoring
# VITE_SENTRY_DSN=

# Optional: Analytics
# VITE_ANALYTICS_ID=
